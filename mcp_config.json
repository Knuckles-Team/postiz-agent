{
  "mcpServers": {
    "postiz-agent": {
      "command": "uv",
      "args": [
        "run",
        "postiz-mcp"
      ],
      "env": {
        "MCP_TOOL_MODE": "intent",
        "ANALYTICSTOOL": "True",
        "INGESTTOOL": "True",
        "INTEGRATIONSTOOL": "True",
        "NOTIFICATIONSTOOL": "True",
        "POSTIZ_KG_INGEST": "1",
        "POSTSTOOL": "True",
        "UPLOADSTOOL": "True",
        "VIDEOTOOL": "True"
      }
    }
  }
}
