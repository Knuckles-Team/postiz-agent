@prefix core: <https://knuckles-team.github.io/ontology/core#> .
@prefix : <https://knuckles-team.github.io/ontology/connector/postiz#> .
@prefix cp: <https://knuckles-team.github.io/ontology/connector-pack#> .
@prefix vg: <https://knuckles-team.github.io/ontology/virtual-graph#> .
@prefix c: <https://knuckles-team.github.io/ontology/connector/postiz#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# The postiz-mcp connector surface (features, tools, prompt, skills), its ingest
# contract, and where its data lives and how reads are routed. Terms of the core
# connector-pack and virtual-graph vocabularies are used by IRI; the pack never
# imports core. Domain classes come from social.ttl and subclass core classes.
# Keep in step with the served tool surface (tests/test_pack_surface.py).

c:connector a cp:Connector ;
    rdfs:label "Postiz social media scheduler" ;
    rdfs:comment "Schedules and publishes posts to the business's social channels and reads their engagement back." ;
    cp:providesFeature c:feature-channels, c:feature-scheduling, c:feature-media, c:feature-review, c:feature-analytics, c:feature-ingest, c:feature-admin ;
    cp:hasContract c:contract .

c:source a vg:SourceConnection ;
    rdfs:label "Postiz public API through the postiz-mcp connector" ;
    rdfs:comment "Posts, channels, media and analytics live in the Postiz instance (its database and media volume). Medulla reads them live through the connector tools and keeps governed copies of ingested posts, channels and engagement." ;
    vg:sourceKind "mcp" ;
    vg:declaredCapability "read", "write-back" .

c:authority-SocialPost a vg:SourceAuthority ;
    vg:authoritativeSource c:source ;
    vg:authorityFor core:SocialPost ;
    vg:authorityRank 1 ;
    vg:authorityContract "mcp" ;
    vg:sourceRole "live_truth" ;
    vg:materialisation "accelerated" ;
    vg:materialisationReason "Posts are ingested on every calendar read so cross-source questions do not call the scheduler." ;
    vg:freshnessMaxAgeSeconds 3600 ;
    vg:allowFallback false .

c:authority-SocialChannel a vg:SourceAuthority ;
    vg:authoritativeSource c:source ;
    vg:authorityFor :SocialChannel ;
    vg:authorityRank 1 ;
    vg:authorityContract "mcp" ;
    vg:sourceRole "live_truth" ;
    vg:materialisation "accelerated" ;
    vg:materialisationReason "Channels change rarely; the ingested copy answers channel questions." ;
    vg:freshnessMaxAgeSeconds 86400 ;
    vg:allowFallback false .

c:authority-EngagementMetric a vg:SourceAuthority ;
    vg:authoritativeSource c:source ;
    vg:authorityFor core:EngagementMetric ;
    vg:authorityRank 1 ;
    vg:authorityContract "mcp" ;
    vg:sourceRole "live_truth" ;
    vg:materialisation "accelerated" ;
    vg:materialisationReason "Provider analytics are rate-limited; daily ingested series serve trend questions." ;
    vg:freshnessMaxAgeSeconds 86400 ;
    vg:allowFallback false .

c:authority-SocialMediaAsset a vg:SourceAuthority ;
    vg:authoritativeSource c:source ;
    vg:authorityFor :SocialMediaAsset ;
    vg:authorityRank 1 ;
    vg:authorityContract "mcp" ;
    vg:sourceRole "live_truth" ;
    vg:materialisation "virtual" ;
    vg:allowFallback false .

c:authority-PostReviewComment a vg:SourceAuthority ;
    vg:authoritativeSource c:source ;
    vg:authorityFor :PostReviewComment ;
    vg:authorityRank 1 ;
    vg:authorityContract "mcp" ;
    vg:sourceRole "live_truth" ;
    vg:materialisation "virtual" ;
    vg:allowFallback false .

c:feature-channels a cp:SurfaceFeature ;
    rdfs:label "Channel management" ;
    cp:realizedBy <tool://postiz-mcp/postiz_list_integrations>, <tool://postiz-mcp/postiz_check_connection>, <tool://postiz-mcp/postiz_get_me>, <tool://postiz-mcp/postiz_list_groups>, <tool://postiz-mcp/postiz_get_integration_settings>, <tool://postiz-mcp/postiz_trigger_integration_tool>, <tool://postiz-mcp/postiz_get_integration_url>, <tool://postiz-mcp/postiz_delete_channel>, <tool://postiz-mcp/postiz_find_slot>, <skill://postiz-channel-management/SKILL.md>, <prompt://postiz-mcp/social_media_manager> .

<tool://postiz-mcp/postiz_list_integrations> a cp:SurfaceTool ;
    cp:componentId "postiz_list_integrations" ;
    cp:operatesOn :SocialChannel ;
    cp:produces :SocialChannel .

<tool://postiz-mcp/postiz_check_connection> a cp:SurfaceTool ;
    cp:componentId "postiz_check_connection" ;
    cp:operatesOn :SocialChannel ;
    cp:produces :SocialChannel .

<tool://postiz-mcp/postiz_get_me> a cp:SurfaceTool ;
    cp:componentId "postiz_get_me" ;
    cp:operatesOn :SocialChannel ;
    cp:produces :SocialChannel .

<tool://postiz-mcp/postiz_list_groups> a cp:SurfaceTool ;
    cp:componentId "postiz_list_groups" ;
    cp:operatesOn :SocialChannel ;
    cp:produces :SocialChannel .

<tool://postiz-mcp/postiz_get_integration_settings> a cp:SurfaceTool ;
    cp:componentId "postiz_get_integration_settings" ;
    cp:operatesOn :SocialChannel ;
    cp:produces :SocialChannel .

<tool://postiz-mcp/postiz_trigger_integration_tool> a cp:SurfaceTool ;
    cp:componentId "postiz_trigger_integration_tool" ;
    cp:operatesOn :SocialChannel ;
    cp:produces :SocialChannel .

<tool://postiz-mcp/postiz_get_integration_url> a cp:SurfaceTool ;
    cp:componentId "postiz_get_integration_url" ;
    cp:operatesOn :SocialChannel ;
    cp:produces :SocialChannel .

<tool://postiz-mcp/postiz_delete_channel> a cp:SurfaceTool ;
    cp:componentId "postiz_delete_channel" ;
    cp:operatesOn :SocialChannel ;
    cp:produces :SocialChannel .

<tool://postiz-mcp/postiz_find_slot> a cp:SurfaceTool ;
    cp:componentId "postiz_find_slot" ;
    cp:operatesOn :ContentCalendar ;
    cp:produces :ContentCalendar .

c:feature-scheduling a cp:SurfaceFeature ;
    rdfs:label "Content scheduling and calendar" ;
    cp:realizedBy <tool://postiz-mcp/postiz_list_posts>, <tool://postiz-mcp/postiz_create_post>, <tool://postiz-mcp/postiz_change_post_status>, <tool://postiz-mcp/postiz_update_post_settings>, <tool://postiz-mcp/postiz_delete_post>, <tool://postiz-mcp/postiz_delete_post_by_group>, <tool://postiz-mcp/postiz_get_missing_content>, <tool://postiz-mcp/postiz_update_release_id>, <skill://postiz-content-scheduling/SKILL.md>, <skill://postiz-campaign-post-from-asset/SKILL.md>, <prompt://postiz-mcp/social_media_manager> .

<tool://postiz-mcp/postiz_list_posts> a cp:SurfaceTool ;
    cp:componentId "postiz_list_posts" ;
    cp:operatesOn core:SocialPost ;
    cp:produces core:SocialPost .

<tool://postiz-mcp/postiz_create_post> a cp:SurfaceTool ;
    cp:componentId "postiz_create_post" ;
    cp:operatesOn core:SocialPost ,
        :DraftScheduleTransition , :DraftPublishNowTransition , :QueuedPublishNowTransition ;
    cp:produces core:SocialPost .

<tool://postiz-mcp/postiz_change_post_status> a cp:SurfaceTool ;
    cp:componentId "postiz_change_post_status" ;
    cp:operatesOn core:SocialPost ,
        :DraftScheduleTransition , :QueuedUnscheduleTransition , :ErrorRetryTransition ;
    cp:produces core:SocialPost .

<tool://postiz-mcp/postiz_update_post_settings> a cp:SurfaceTool ;
    cp:componentId "postiz_update_post_settings" ;
    cp:operatesOn core:SocialPost ,
        :DraftEditTransition , :QueuedEditTransition ;
    cp:produces core:SocialPost .

<tool://postiz-mcp/postiz_delete_post> a cp:SurfaceTool ;
    cp:componentId "postiz_delete_post" ;
    cp:operatesOn core:SocialPost ,
        :DraftDeleteTransition , :QueuedDeleteTransition , :ErrorDeleteTransition , :PublishedDeleteTransition ;
    cp:produces core:SocialPost .

<tool://postiz-mcp/postiz_delete_post_by_group> a cp:SurfaceTool ;
    cp:componentId "postiz_delete_post_by_group" ;
    cp:operatesOn core:SocialPost ,
        :DraftDeleteTransition , :QueuedDeleteTransition , :ErrorDeleteTransition , :PublishedDeleteTransition ;
    cp:produces core:SocialPost .

<tool://postiz-mcp/postiz_get_missing_content> a cp:SurfaceTool ;
    cp:componentId "postiz_get_missing_content" ;
    cp:operatesOn core:SocialPost ;
    cp:produces core:SocialPost .

<tool://postiz-mcp/postiz_update_release_id> a cp:SurfaceTool ;
    cp:componentId "postiz_update_release_id" ;
    cp:operatesOn core:SocialPost ,
        :PublishingRecordReleaseTransition , :PublishedRecordReleaseTransition ;
    cp:produces core:SocialPost .

c:feature-media a cp:SurfaceFeature ;
    rdfs:label "Media library and generation" ;
    cp:realizedBy <tool://postiz-mcp/postiz_upload_file>, <tool://postiz-mcp/postiz_upload_file_content>, <tool://postiz-mcp/postiz_upload_from_url>, <tool://postiz-mcp/postiz_list_media>, <tool://postiz-mcp/postiz_generate_video>, <tool://postiz-mcp/postiz_video_function>, <tool://postiz-mcp/postiz_start_clipping>, <tool://postiz-mcp/postiz_list_clippings>, <tool://postiz-mcp/postiz_get_clipping>, <skill://postiz-campaign-post-from-asset/SKILL.md>, <prompt://postiz-mcp/social_media_manager> .

<tool://postiz-mcp/postiz_upload_file> a cp:SurfaceTool ;
    cp:componentId "postiz_upload_file" ;
    cp:operatesOn :SocialMediaAsset ;
    cp:produces :SocialMediaAsset .

<tool://postiz-mcp/postiz_upload_file_content> a cp:SurfaceTool ;
    cp:componentId "postiz_upload_file_content" ;
    cp:operatesOn :SocialMediaAsset ;
    cp:produces :SocialMediaAsset .

<tool://postiz-mcp/postiz_upload_from_url> a cp:SurfaceTool ;
    cp:componentId "postiz_upload_from_url" ;
    cp:operatesOn :SocialMediaAsset ;
    cp:produces :SocialMediaAsset .

<tool://postiz-mcp/postiz_list_media> a cp:SurfaceTool ;
    cp:componentId "postiz_list_media" ;
    cp:operatesOn :SocialMediaAsset ;
    cp:produces :SocialMediaAsset .

<tool://postiz-mcp/postiz_generate_video> a cp:SurfaceTool ;
    cp:componentId "postiz_generate_video" ;
    cp:operatesOn :SocialMediaAsset ;
    cp:produces :SocialMediaAsset .

<tool://postiz-mcp/postiz_video_function> a cp:SurfaceTool ;
    cp:componentId "postiz_video_function" ;
    cp:operatesOn :SocialMediaAsset ;
    cp:produces :SocialMediaAsset .

<tool://postiz-mcp/postiz_start_clipping> a cp:SurfaceTool ;
    cp:componentId "postiz_start_clipping" ;
    cp:operatesOn :SocialMediaAsset ;
    cp:produces :SocialMediaAsset .

<tool://postiz-mcp/postiz_list_clippings> a cp:SurfaceTool ;
    cp:componentId "postiz_list_clippings" ;
    cp:operatesOn :SocialMediaAsset ;
    cp:produces :SocialMediaAsset .

<tool://postiz-mcp/postiz_get_clipping> a cp:SurfaceTool ;
    cp:componentId "postiz_get_clipping" ;
    cp:operatesOn :SocialMediaAsset ;
    cp:produces :SocialMediaAsset .

c:feature-review a cp:SurfaceFeature ;
    rdfs:label "Preview and review comments" ;
    cp:realizedBy <tool://postiz-mcp/postiz_get_post_preview>, <tool://postiz-mcp/postiz_list_post_comments>, <tool://postiz-mcp/postiz_create_post_comment>, <skill://postiz-campaign-post-from-asset/SKILL.md>, <prompt://postiz-mcp/social_media_manager> .

<tool://postiz-mcp/postiz_get_post_preview> a cp:SurfaceTool ;
    cp:componentId "postiz_get_post_preview" ;
    cp:operatesOn core:SocialPost ;
    cp:produces core:SocialPost .

<tool://postiz-mcp/postiz_list_post_comments> a cp:SurfaceTool ;
    cp:componentId "postiz_list_post_comments" ;
    cp:operatesOn :PostReviewComment ;
    cp:produces :PostReviewComment .

<tool://postiz-mcp/postiz_create_post_comment> a cp:SurfaceTool ;
    cp:componentId "postiz_create_post_comment" ;
    cp:operatesOn :PostReviewComment ;
    cp:produces :PostReviewComment .

c:feature-analytics a cp:SurfaceFeature ;
    rdfs:label "Audience analytics and notifications" ;
    cp:realizedBy <tool://postiz-mcp/postiz_get_analytics>, <tool://postiz-mcp/postiz_get_post_analytics>, <tool://postiz-mcp/postiz_list_notifications>, <skill://postiz-audience-analytics/SKILL.md>, <prompt://postiz-mcp/social_media_manager> .

<tool://postiz-mcp/postiz_get_analytics> a cp:SurfaceTool ;
    cp:componentId "postiz_get_analytics" ;
    cp:operatesOn :AggregatedEngagement ;
    cp:produces :AggregatedEngagement .

<tool://postiz-mcp/postiz_get_post_analytics> a cp:SurfaceTool ;
    cp:componentId "postiz_get_post_analytics" ;
    cp:operatesOn core:EngagementMetric ;
    cp:produces core:EngagementMetric .

<tool://postiz-mcp/postiz_list_notifications> a cp:SurfaceTool ;
    cp:componentId "postiz_list_notifications" ;
    cp:operatesOn :SocialNotification ;
    cp:produces :SocialNotification .

c:feature-ingest a cp:SurfaceFeature ;
    rdfs:label "Knowledge-graph ingest" ;
    cp:realizedBy <tool://postiz-mcp/postiz_ingest_posts>, <tool://postiz-mcp/postiz_ingest_integrations>, <tool://postiz-mcp/postiz_ingest_analytics>, <skill://postiz-audience-analytics/SKILL.md>, <prompt://postiz-mcp/social_media_manager> .

<tool://postiz-mcp/postiz_ingest_posts> a cp:SurfaceTool ;
    cp:componentId "postiz_ingest_posts" ;
    cp:operatesOn core:SocialPost ;
    cp:produces core:SocialPost .

<tool://postiz-mcp/postiz_ingest_integrations> a cp:SurfaceTool ;
    cp:componentId "postiz_ingest_integrations" ;
    cp:operatesOn :SocialChannel ;
    cp:produces :SocialChannel .

<tool://postiz-mcp/postiz_ingest_analytics> a cp:SurfaceTool ;
    cp:componentId "postiz_ingest_analytics" ;
    cp:operatesOn :DailyEngagement ;
    cp:produces :DailyEngagement .

c:feature-admin a cp:SurfaceFeature ;
    rdfs:label "Instance diagnostics (super-admin key)" ;
    cp:realizedBy <tool://postiz-mcp/postiz_list_users>, <tool://postiz-mcp/postiz_get_post_timeline>, <tool://postiz-mcp/postiz_get_account_overview>, <tool://postiz-mcp/postiz_get_channel_health>, <tool://postiz-mcp/postiz_get_org_activity>, <tool://postiz-mcp/postiz_reset_credits>, <skill://postiz-agent-operations/SKILL.md>, <prompt://postiz-mcp/social_media_manager> .

<tool://postiz-mcp/postiz_list_users> a cp:SurfaceTool ;
    cp:componentId "postiz_list_users" ;
    cp:operatesOn :SocialChannel ;
    cp:produces :SocialChannel .

<tool://postiz-mcp/postiz_get_post_timeline> a cp:SurfaceTool ;
    cp:componentId "postiz_get_post_timeline" ;
    cp:operatesOn core:SocialPost ;
    cp:produces core:SocialPost .

<tool://postiz-mcp/postiz_get_account_overview> a cp:SurfaceTool ;
    cp:componentId "postiz_get_account_overview" ;
    cp:operatesOn :SocialChannel ;
    cp:produces :SocialChannel .

<tool://postiz-mcp/postiz_get_channel_health> a cp:SurfaceTool ;
    cp:componentId "postiz_get_channel_health" ;
    cp:operatesOn :SocialChannel ;
    cp:produces :SocialChannel .

<tool://postiz-mcp/postiz_get_org_activity> a cp:SurfaceTool ;
    cp:componentId "postiz_get_org_activity" ;
    cp:operatesOn core:SocialPost ;
    cp:produces core:SocialPost .

<tool://postiz-mcp/postiz_reset_credits> a cp:SurfaceTool ;
    cp:componentId "postiz_reset_credits" ;
    cp:operatesOn :SocialMediaAsset ;
    cp:produces :SocialMediaAsset .

<prompt://postiz-mcp/social_media_manager> a cp:SurfacePrompt ;
    cp:componentId "social_media_manager" ;
    cp:appliesTo core:SocialPost .

<prompt://postiz-mcp/postiz-operator> a cp:SurfacePrompt ;
    cp:componentId "postiz-operator" ;
    cp:appliesTo core:SocialPost .

<prompt://postiz-mcp/postiz-channel-administrator> a cp:SurfacePrompt ;
    cp:componentId "postiz-channel-administrator" ;
    cp:appliesTo :SocialChannel .

<skill://postiz-account-administration/SKILL.md> a cp:SurfaceSkill ;
    cp:componentId "postiz-account-administration" ;
    cp:appliesTo :SocialMediaAsset .

<skill://postiz-campaign-post-from-asset/SKILL.md> a cp:SurfaceSkill ;
    cp:componentId "postiz-campaign-post-from-asset" ;
    cp:appliesTo core:SocialPost .

<skill://postiz-content-scheduling/SKILL.md> a cp:SurfaceSkill ;
    cp:componentId "postiz-content-scheduling" ;
    cp:appliesTo core:SocialPost .

<skill://postiz-channel-management/SKILL.md> a cp:SurfaceSkill ;
    cp:componentId "postiz-channel-management" ;
    cp:appliesTo :SocialChannel .

<skill://postiz-audience-analytics/SKILL.md> a cp:SurfaceSkill ;
    cp:componentId "postiz-audience-analytics" ;
    cp:appliesTo core:EngagementMetric .

<skill://postiz-agent-operations/SKILL.md> a cp:SurfaceSkill ;
    cp:componentId "postiz-agent-operations" ;
    cp:appliesTo core:SocialPost .

c:contract a cp:IngestContract ;
    cp:contractOf c:connector ;
    cp:contractVersion "2" ;
    cp:privacyClass "internal" ;
    cp:hasSourceObject c:object-post, c:object-channel, c:object-engagement ;
    cp:hasCursorPolicy c:cursor ;
    cp:hasAccessPolicy c:access ;
    cp:requiresProvenance c:provenance .

c:object-post a cp:SourceObjectMapping ;
    cp:objectName "posts" ;
    cp:ontologyClass core:SocialPost ;
    cp:hasKeyRule c:key-post .

c:key-post a cp:KeyRule ;
    cp:keyField "id" .

c:object-channel a cp:SourceObjectMapping ;
    cp:objectName "integrations" ;
    cp:ontologyClass :SocialChannel ;
    cp:hasKeyRule c:key-channel .

c:key-channel a cp:KeyRule ;
    cp:keyField "id" .

c:object-engagement a cp:SourceObjectMapping ;
    cp:objectName "analytics" ;
    cp:ontologyClass :DailyEngagement ;
    cp:hasKeyRule c:key-engagement .

c:key-engagement a cp:KeyRule ;
    cp:keyField "integration_id", "label", "date" .

c:cursor a cp:CursorPolicy ;
    cp:cursorKind "timestamp" .

c:access a cp:IngestAccessPolicy ;
    cp:defaultAcl "quarantine" .

c:provenance a cp:ProvenanceRequirement ;
    cp:requiredField "source", "record_id", "as_of" .
