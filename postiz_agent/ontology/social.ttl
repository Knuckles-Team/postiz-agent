@prefix fibo-fi: <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/> .
@prefix fibo-org: <https://spec.edmcouncil.org/fibo/ontology/FND/Organizations/Organizations/> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix : <http://knuckles.team/kg#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:aggregatesDaily a owl:ObjectProperty ;
    rdfs:label "aggregates daily" ;
    rdfs:comment """Links an AggregatedEngagement to its constituent DailyEngagement
nodes. Enables drill-down from totals to daily trends.""" ;
    rdfs:domain :AggregatedEngagement ;
    rdfs:range :DailyEngagement .

:broadcastEngagement a owl:ObjectProperty ;
    rdfs:label "broadcast engagement" ;
    rdfs:comment "Links an EngagementMetric to a BroadcastSession." ;
    rdfs:domain :EngagementMetric ;
    rdfs:range :BroadcastSession .

:broadcastedVia a owl:ObjectProperty ;
    rdfs:label "broadcasted via" ;
    rdfs:comment "Links a BroadcastSession to the streaming platform System." ;
    rdfs:domain :BroadcastSession ;
    rdfs:range :System .

:comments a owl:DatatypeProperty ;
    rdfs:label "comments" ;
    rdfs:domain :EngagementMetric ;
    rdfs:range xsd:integer .

:concurrentViewers a owl:DatatypeProperty ;
    rdfs:label "concurrent viewers" ;
    rdfs:domain :AudienceMetric ;
    rdfs:range xsd:integer .

:createdBy a owl:ObjectProperty ;
    rdfs:label "created by" ;
    rdfs:domain :SocialPost ;
    rdfs:range :Person .

:derivedFromContent a owl:ObjectProperty ;
    rdfs:label "derived from content" ;
    rdfs:comment "Links a BroadcastSession to the SocialPost that inspired it." ;
    rdfs:domain :BroadcastSession ;
    rdfs:range :SocialPost .

:engagementDate a owl:DatatypeProperty ;
    rdfs:label "engagement date" ;
    rdfs:domain :DailyEngagement ;
    rdfs:range xsd:date .

:engagementOf a owl:ObjectProperty ;
    rdfs:label "engagement of" ;
    rdfs:comment "Links an EngagementMetric to its source content." ;
    rdfs:domain :EngagementMetric ;
    rdfs:range :SocialPost .

:highlightFrom a owl:ObjectProperty ;
    rdfs:label "highlight from" ;
    rdfs:domain :StreamHighlight ;
    rdfs:range :BroadcastSession .

:impressions a owl:DatatypeProperty ;
    rdfs:label "impressions" ;
    rdfs:domain :EngagementMetric ;
    rdfs:range xsd:integer .

:likes a owl:DatatypeProperty ;
    rdfs:label "likes" ;
    rdfs:domain :EngagementMetric ;
    rdfs:range xsd:integer .

:peakViewers a owl:DatatypeProperty ;
    rdfs:label "peak viewers" ;
    rdfs:domain :AudienceMetric ;
    rdfs:range xsd:integer .

:platform a owl:DatatypeProperty ;
    rdfs:label "platform name" ;
    rdfs:comment "Platform identifier: postiz, owncast, x, linkedin, etc." ;
    rdfs:domain :SocialPost ;
    rdfs:range xsd:string .

:promotesResearch a owl:ObjectProperty ;
    rdfs:label "promotes research" ;
    rdfs:comment "Links a SocialPost to the research Document it promotes." ;
    rdfs:domain :SocialPost ;
    rdfs:range :Document .

:publishedOn a owl:ObjectProperty ;
    rdfs:label "published on" ;
    rdfs:comment "Links a SocialPost to the platform System it was published on." ;
    rdfs:domain :SocialPost ;
    rdfs:range :System .

:reach a owl:DatatypeProperty ;
    rdfs:label "reach" ;
    rdfs:domain :EngagementMetric ;
    rdfs:range xsd:integer .

:scheduledIn a owl:ObjectProperty ;
    rdfs:label "scheduled in" ;
    rdfs:comment "Links a SocialPost to its ContentCalendar slot." ;
    rdfs:domain :SocialPost ;
    rdfs:range :ContentCalendar .

:shares a owl:DatatypeProperty ;
    rdfs:label "shares" ;
    rdfs:domain :EngagementMetric ;
    rdfs:range xsd:integer .

<http://knuckles.team/kg/social> a owl:Ontology ;
    rdfs:label "Social & Content Ontology" ;
    rdfs:comment """Social media, content creation, and audience engagement ontology
bridging Postiz (content scheduling), Owncast (live streaming), and
social network analytics into the unified KG.

Supports both time-series engagement observations (one node per day for
trend analysis) AND aggregated snapshots (lifetime totals) with explicit
relationships between them.

Standards alignment: schema:SocialMediaPosting, schema:BroadcastEvent.""" .


:AggregatedEngagement a owl:Class ;
    rdfs:label "Aggregated Engagement" ;
    rdfs:comment """Lifetime or period-total engagement snapshot for a SocialPost
or BroadcastSession. Computed from DailyEngagement nodes.
Updated incrementally as new daily data arrives.""" ;
    rdfs:subClassOf :EngagementMetric .

:ContentCalendar a owl:Class ;
    rdfs:label "Content Calendar" ;
    rdfs:comment """A scheduled content publishing window. Organizes SocialPosts
into a coherent publication strategy. BFO:TemporalRegion via Phase.""" ;
    rdfs:subClassOf :Phase .

:StreamHighlight a owl:Class ;
    rdfs:label "Stream Highlight" ;
    rdfs:comment "A clipped highlight segment from a BroadcastSession." ;
    rdfs:subClassOf :CreativeWork .

:AudienceMetric a owl:Class ;
    rdfs:label "Audience Metric" ;
    rdfs:comment """Audience composition and reach data for a BroadcastSession.
Peak viewers, concurrent viewers, unique visitors.""" ;
    rdfs:subClassOf :Observation .

:DailyEngagement a owl:Class ;
    rdfs:label "Daily Engagement" ;
    rdfs:comment """A single day's engagement data point for a SocialPost or
BroadcastSession. Enables time-series trend analysis across days.
One node per day per content item.""" ;
    rdfs:subClassOf :EngagementMetric .

:BroadcastSession a owl:Class ;
    rdfs:label "Broadcast Session" ;
    rdfs:comment """A live stream session on Owncast or equivalent platform.
BFO:Process via Event. Aligned to schema:BroadcastEvent.""" ;
    rdfs:seeAlso schema:BroadcastEvent ;
    rdfs:subClassOf :Event .

:SocialPost a owl:Class ;
    rdfs:label "Social Post" ;
    rdfs:comment """A post published to one or more social platforms via Postiz.
BFO:GenericallyDependentContinuant. Aligned to schema:SocialMediaPosting.""" ;
    rdfs:seeAlso schema:SocialMediaPosting ;
    rdfs:subClassOf :CreativeWork .

:EngagementMetric a owl:Class ;
    rdfs:label "Engagement Metric" ;
    rdfs:comment """Base class for engagement data. Both time-series observations
and aggregated snapshots inherit from this class.
BFO:SpecificallyDependentContinuant via Observation.""" ;
    rdfs:subClassOf :Observation .


# --- Fleet-enrichment extensions (postiz-agent native ingestion) -------------

:SocialChannel a owl:Class ;
    rdfs:label "Social Channel" ;
    rdfs:comment """A connected social account / integration managed by Postiz
(an X, LinkedIn, Mastodon, Bluesky, … channel). A SocialPost is published on
one or more channels. Subclass of :System so :publishedOn resolves to it.""" ;
    rdfs:seeAlso foaf:OnlineAccount ;
    rdfs:subClassOf :System .

:hasMedia a owl:ObjectProperty ;
    rdfs:label "has media" ;
    rdfs:comment "Links a SocialPost to an AssetOccurrence blob (image/video) attached to it." ;
    rdfs:domain :SocialPost ;
    rdfs:range :AssetOccurrence .

:providerIdentifier a owl:DatatypeProperty ;
    rdfs:label "provider identifier" ;
    rdfs:comment "The upstream provider slug of a SocialChannel (x, linkedin, mastodon, …)." ;
    rdfs:domain :SocialChannel ;
    rdfs:range xsd:string .

:channelDisabled a owl:DatatypeProperty ;
    rdfs:label "channel disabled" ;
    rdfs:comment "Whether a SocialChannel integration is currently disabled." ;
    rdfs:domain :SocialChannel ;
    rdfs:range xsd:boolean .

:publishDate a owl:DatatypeProperty ;
    rdfs:label "publish date" ;
    rdfs:comment "Scheduled or actual publish timestamp of a SocialPost (ISO-8601)." ;
    rdfs:domain :SocialPost ;
    rdfs:range xsd:dateTime .

:releaseURL a owl:DatatypeProperty ;
    rdfs:label "release URL" ;
    rdfs:comment "Public URL of a SocialPost once published on its channel." ;
    rdfs:domain :SocialPost ;
    rdfs:range xsd:anyURI .

:engagementTotal a owl:DatatypeProperty ;
    rdfs:label "engagement total" ;
    rdfs:comment "The measured value of a DailyEngagement/AggregatedEngagement observation for its metric label." ;
    rdfs:domain :EngagementMetric ;
    rdfs:range xsd:integer .

:metricLabel a owl:DatatypeProperty ;
    rdfs:label "metric label" ;
    rdfs:comment "The analytics series label an EngagementMetric observes (e.g. Impressions, Likes, Followers)." ;
    rdfs:domain :EngagementMetric ;
    rdfs:range xsd:string .


# --- Media library, preview review and notifications ------------------------

:SocialMediaAsset a owl:Class ;
    rdfs:label "Social Media Asset" ;
    rdfs:comment """One item of the scheduler's media library (an image or a short
video) that posts attach. Rolls up to the core media item.""" ;
    rdfs:seeAlso schema:MediaObject ;
    rdfs:subClassOf :MediaItem .

:PostReviewComment a owl:Class ;
    rdfs:label "Post Review Comment" ;
    rdfs:comment """An internal review comment left on a post's preview before it
publishes. Never posted to the social network.""" ;
    rdfs:seeAlso schema:Comment ;
    rdfs:subClassOf :Message .

:SocialNotification a owl:Class ;
    rdfs:label "Social Notification" ;
    rdfs:comment """A scheduler event about a channel or post: published (with its
public URL), failed, or channel disconnected.""" ;
    rdfs:subClassOf :Message .

:hasReviewComment a owl:ObjectProperty ;
    rdfs:label "has review comment" ;
    rdfs:comment "Links a SocialPost to a review comment left on its preview." ;
    rdfs:domain :SocialPost ;
    rdfs:range :PostReviewComment .

:usesMediaAsset a owl:ObjectProperty ;
    rdfs:label "uses media asset" ;
    rdfs:comment "Links a SocialPost to the media-library item it attaches." ;
    rdfs:domain :SocialPost ;
    rdfs:range :SocialMediaAsset .

# --- Post lifecycle machine (mirrors postiz_agent/lifecycle.py) ---

:PostLifecycle a owl:Class ;
    rdfs:label "Post Lifecycle" ;
    rdfs:comment "The state machine of a Postiz post: Draft, Queued, Publishing, Published, Error, Deleted (terminal)." ;
    rdfs:subClassOf :StateMachine .

:DraftState a owl:Class ;
    rdfs:label "Draft state" ;
    rdfs:comment "The Draft state of a post lifecycle." ;
    rdfs:subClassOf :State .

:QueuedState a owl:Class ;
    rdfs:label "Queued state" ;
    rdfs:comment "The Queued state of a post lifecycle." ;
    rdfs:subClassOf :State .

:PublishingState a owl:Class ;
    rdfs:label "Publishing state" ;
    rdfs:comment "The Publishing state of a post lifecycle. This is a connector-side state, persisted by the connector; it is not an observed upstream value." ;
    rdfs:subClassOf :State .

:PublishedState a owl:Class ;
    rdfs:label "Published state" ;
    rdfs:comment "The Published state of a post lifecycle." ;
    rdfs:subClassOf :State .

:ErrorState a owl:Class ;
    rdfs:label "Error state" ;
    rdfs:comment "The Error state of a post lifecycle." ;
    rdfs:subClassOf :State .

:DeletedState a owl:Class ;
    rdfs:label "Deleted state" ;
    rdfs:comment "The Deleted state of a post lifecycle." ;
    rdfs:subClassOf :State .

:SchedulePostEvent a owl:Class ;
    rdfs:label "Schedule event" ;
    rdfs:comment "The Schedule event of the post lifecycle." ;
    rdfs:subClassOf :Event .

:PublishNowEvent a owl:Class ;
    rdfs:label "PublishNow event" ;
    rdfs:comment "The PublishNow event of the post lifecycle." ;
    rdfs:subClassOf :Event .

:UnscheduleEvent a owl:Class ;
    rdfs:label "Unschedule event" ;
    rdfs:comment "The Unschedule event of the post lifecycle." ;
    rdfs:subClassOf :Event .

:EditEvent a owl:Class ;
    rdfs:label "Edit event" ;
    rdfs:comment "The Edit event of the post lifecycle." ;
    rdfs:subClassOf :Event .

:SucceedEvent a owl:Class ;
    rdfs:label "Succeed event" ;
    rdfs:comment "The Succeed event of the post lifecycle." ;
    rdfs:subClassOf :Event .

:FailEvent a owl:Class ;
    rdfs:label "Fail event" ;
    rdfs:comment "The Fail event of the post lifecycle." ;
    rdfs:subClassOf :Event .

:RetryEvent a owl:Class ;
    rdfs:label "Retry event" ;
    rdfs:comment "The Retry event of the post lifecycle." ;
    rdfs:subClassOf :Event .

:RecordReleaseEvent a owl:Class ;
    rdfs:label "RecordRelease event" ;
    rdfs:comment "The RecordRelease event of the post lifecycle." ;
    rdfs:subClassOf :Event .

:DeleteEvent a owl:Class ;
    rdfs:label "Delete event" ;
    rdfs:comment "The Delete event of the post lifecycle." ;
    rdfs:subClassOf :Event .

:EditableStateGuard a owl:Class ;
    rdfs:label "editable_state" ;
    rdfs:comment "Guard editable_state of the post lifecycle." ;
    rdfs:subClassOf :TransitionGuard .

:RetryFromErrorGuard a owl:Class ;
    rdfs:label "retry_from_error" ;
    rdfs:comment "Guard retry_from_error of the post lifecycle." ;
    rdfs:subClassOf :TransitionGuard .

:ScheduleInFutureGuard a owl:Class ;
    rdfs:label "schedule_in_future" ;
    rdfs:comment "Guard schedule_in_future of the post lifecycle." ;
    rdfs:subClassOf :TransitionGuard .

:DeletePublishedUnlistsGuard a owl:Class ;
    rdfs:label "delete_published_unlists" ;
    rdfs:comment "Guard delete_published_unlists of the post lifecycle." ;
    rdfs:subClassOf :TransitionGuard .

:DraftScheduleTransition a owl:Class ;
    rdfs:label "Draft Schedule transition" ;
    rdfs:comment "Draft on Schedule reaches Queued." ;
    :fromState :DraftState ;
    :onEvent :SchedulePostEvent ;
    :toState :QueuedState ;
    :guardedBy :ScheduleInFutureGuard ;
    rdfs:subClassOf :Transition .

:DraftPublishNowTransition a owl:Class ;
    rdfs:label "Draft PublishNow transition" ;
    rdfs:comment "Draft on PublishNow reaches Publishing." ;
    :fromState :DraftState ;
    :onEvent :PublishNowEvent ;
    :toState :PublishingState ;
    rdfs:subClassOf :Transition .

:QueuedUnscheduleTransition a owl:Class ;
    rdfs:label "Queued Unschedule transition" ;
    rdfs:comment "Queued on Unschedule reaches Draft." ;
    :fromState :QueuedState ;
    :onEvent :UnscheduleEvent ;
    :toState :DraftState ;
    rdfs:subClassOf :Transition .

:QueuedPublishNowTransition a owl:Class ;
    rdfs:label "Queued PublishNow transition" ;
    rdfs:comment "Queued on PublishNow reaches Publishing." ;
    :fromState :QueuedState ;
    :onEvent :PublishNowEvent ;
    :toState :PublishingState ;
    rdfs:subClassOf :Transition .

:PublishingSucceedTransition a owl:Class ;
    rdfs:label "Publishing Succeed transition" ;
    rdfs:comment "Publishing on Succeed reaches Published." ;
    :fromState :PublishingState ;
    :onEvent :SucceedEvent ;
    :toState :PublishedState ;
    rdfs:subClassOf :Transition .

:PublishingFailTransition a owl:Class ;
    rdfs:label "Publishing Fail transition" ;
    rdfs:comment "Publishing on Fail reaches Error." ;
    :fromState :PublishingState ;
    :onEvent :FailEvent ;
    :toState :ErrorState ;
    rdfs:subClassOf :Transition .

:ErrorRetryTransition a owl:Class ;
    rdfs:label "Error Retry transition" ;
    rdfs:comment "Error on Retry reaches Queued." ;
    :fromState :ErrorState ;
    :onEvent :RetryEvent ;
    :toState :QueuedState ;
    :guardedBy :RetryFromErrorGuard ;
    rdfs:subClassOf :Transition .

:DraftEditTransition a owl:Class ;
    rdfs:label "Draft Edit transition" ;
    rdfs:comment "Draft on Edit reaches Draft." ;
    :fromState :DraftState ;
    :onEvent :EditEvent ;
    :toState :DraftState ;
    :guardedBy :EditableStateGuard ;
    rdfs:subClassOf :Transition .

:QueuedEditTransition a owl:Class ;
    rdfs:label "Queued Edit transition" ;
    rdfs:comment "Queued on Edit reaches Queued." ;
    :fromState :QueuedState ;
    :onEvent :EditEvent ;
    :toState :QueuedState ;
    :guardedBy :EditableStateGuard ;
    rdfs:subClassOf :Transition .

:PublishingRecordReleaseTransition a owl:Class ;
    rdfs:label "Publishing RecordRelease transition" ;
    rdfs:comment "Publishing on RecordRelease reaches Published." ;
    :fromState :PublishingState ;
    :onEvent :RecordReleaseEvent ;
    :toState :PublishedState ;
    rdfs:subClassOf :Transition .

:PublishedRecordReleaseTransition a owl:Class ;
    rdfs:label "Published RecordRelease transition" ;
    rdfs:comment "Published on RecordRelease reaches Published." ;
    :fromState :PublishedState ;
    :onEvent :RecordReleaseEvent ;
    :toState :PublishedState ;
    rdfs:subClassOf :Transition .

:DraftDeleteTransition a owl:Class ;
    rdfs:label "Draft Delete transition" ;
    rdfs:comment "Draft on Delete reaches Deleted." ;
    :fromState :DraftState ;
    :onEvent :DeleteEvent ;
    :toState :DeletedState ;
    :guardedBy :DeletePublishedUnlistsGuard ;
    rdfs:subClassOf :Transition .

:QueuedDeleteTransition a owl:Class ;
    rdfs:label "Queued Delete transition" ;
    rdfs:comment "Queued on Delete reaches Deleted." ;
    :fromState :QueuedState ;
    :onEvent :DeleteEvent ;
    :toState :DeletedState ;
    :guardedBy :DeletePublishedUnlistsGuard ;
    rdfs:subClassOf :Transition .

:ErrorDeleteTransition a owl:Class ;
    rdfs:label "Error Delete transition" ;
    rdfs:comment "Error on Delete reaches Deleted." ;
    :fromState :ErrorState ;
    :onEvent :DeleteEvent ;
    :toState :DeletedState ;
    :guardedBy :DeletePublishedUnlistsGuard ;
    rdfs:subClassOf :Transition .

:PublishedDeleteTransition a owl:Class ;
    rdfs:label "Published Delete transition" ;
    rdfs:comment "Published on Delete reaches Deleted." ;
    :fromState :PublishedState ;
    :onEvent :DeleteEvent ;
    :toState :DeletedState ;
    :guardedBy :DeletePublishedUnlistsGuard ;
    rdfs:subClassOf :Transition .

:IllegalMoveRefusal a owl:Class ;
    rdfs:label "IllegalMove" ;
    rdfs:comment "Refusal reason IllegalMove: the move is refused before any server call." ;
    rdfs:subClassOf :RefusalCode .

:TerminalStateRefusal a owl:Class ;
    rdfs:label "TerminalState" ;
    rdfs:comment "Refusal reason TerminalState: the move is refused before any server call." ;
    rdfs:subClassOf :RefusalCode .

:UnknownIntentRefusal a owl:Class ;
    rdfs:label "UnknownIntent" ;
    rdfs:comment "Refusal reason UnknownIntent: the move is refused before any server call." ;
    rdfs:subClassOf :RefusalCode .

:UnknownServerStateRefusal a owl:Class ;
    rdfs:label "UnknownServerState" ;
    rdfs:comment "Refusal reason UnknownServerState: the move is refused before any server call." ;
    rdfs:subClassOf :RefusalCode .

:ReleaseWithoutPublishRefusal a owl:Class ;
    rdfs:label "ReleaseWithoutPublish" ;
    rdfs:comment "Refusal reason ReleaseWithoutPublish: the move is refused before any server call." ;
    rdfs:subClassOf :RefusalCode .

:ScheduleInPastRefusal a owl:Class ;
    rdfs:label "ScheduleInPast" ;
    rdfs:comment "Refusal reason ScheduleInPast: the move is refused before any server call." ;
    rdfs:subClassOf :RefusalCode .

:UnknownPostRefusal a owl:Class ;
    rdfs:label "UnknownPost" ;
    rdfs:comment "Refusal reason UnknownPost: the move is refused before any server call." ;
    rdfs:subClassOf :RefusalCode .

:fromState a owl:ObjectProperty ;
    rdfs:label "from state" ;
    rdfs:domain :Transition .

:toState a owl:ObjectProperty ;
    rdfs:label "to state" ;
    rdfs:domain :Transition .

:onEvent a owl:ObjectProperty ;
    rdfs:label "on event" ;
    rdfs:domain :Transition .

:guardedBy a owl:ObjectProperty ;
    rdfs:label "guarded by" ;
    rdfs:domain :Transition .

:lifecycleState a owl:ObjectProperty ;
    rdfs:label "lifecycle state" ;
    rdfs:comment "The derived lifecycle state of a SocialPost; the stored field is the server state." ;
    rdfs:domain :SocialPost ;
    rdfs:range :State .
