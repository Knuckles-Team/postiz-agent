{
  "mcpServers": {
    "postiz-agent": {
      "command": "uv",
      "args": [
        "run",
        "postiz-mcp"
      ],
      "env": {
        "MCP_TOOL_MODE": "condensed",
        "ANALYTICSTOOL": "True",
        "INTEGRATIONSTOOL": "True",
        "NOTIFICATIONSTOOL": "True",
        "POSTIZ_TOKEN": "",
        "POSTIZ_URL": "",
        "POSTSTOOL": "True",
        "UPLOADSTOOL": "True",
        "VIDEOTOOL": "True"
      }
    }
  }
}
