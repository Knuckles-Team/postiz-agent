c:feature-ingest a cp:Feature ;
    rdfs:label "Knowledge-graph ingest" ;
    cp:realizedBy c:tool-postiz_ingest_posts, c:tool-postiz_ingest_integrations, c:tool-postiz_ingest_analytics, c:skill-postiz-audience-analytics, c:prompt-social_media_manager .

c:tool-postiz_ingest_posts a cp:Tool ;
    cp:componentId "postiz_ingest_posts" ;
    cp:operatesOn :SocialPost ;
    cp:produces :SocialPost .

c:tool-postiz_ingest_integrations a cp:Tool ;
    cp:componentId "postiz_ingest_integrations" ;
    cp:operatesOn :SocialChannel ;
    cp:produces :SocialChannel .

c:tool-postiz_ingest_analytics a cp:Tool ;
    cp:componentId "postiz_ingest_analytics" ;
    cp:operatesOn :DailyEngagement ;
    cp:produces :DailyEngagement .

c:feature-admin a cp:Feature ;
    rdfs:label "Instance diagnostics (super-admin key)" ;
    cp:realizedBy c:tool-postiz_list_users, c:tool-postiz_get_post_timeline, c:tool-postiz_get_account_overview, c:tool-postiz_get_channel_health, c:tool-postiz_get_org_activity, c:tool-postiz_reset_credits, c:skill-postiz-agent-operations, c:prompt-social_media_manager .

c:tool-postiz_list_users a cp:Tool ;
    cp:componentId "postiz_list_users" ;
    cp:operatesOn :SocialChannel ;
    cp:produces :SocialChannel .

c:tool-postiz_get_post_timeline a cp:Tool ;
    cp:componentId "postiz_get_post_timeline" ;
    cp:operatesOn :SocialPost ;
    cp:produces :SocialPost .

c:tool-postiz_get_account_overview a cp:Tool ;
    cp:componentId "postiz_get_account_overview" ;
    cp:operatesOn :SocialChannel ;
    cp:produces :SocialChannel .

c:tool-postiz_get_channel_health a cp:Tool ;
    cp:componentId "postiz_get_channel_health" ;
    cp:operatesOn :SocialChannel ;
    cp:produces :SocialChannel .

c:tool-postiz_get_org_activity a cp:Tool ;
    cp:componentId "postiz_get_org_activity" ;
    cp:operatesOn :SocialPost ;
    cp:produces :SocialPost .

c:tool-postiz_reset_credits a cp:Tool ;
    cp:componentId "postiz_reset_credits" ;
    cp:operatesOn :SocialMediaAsset ;
    cp:produces :SocialMediaAsset .

c:prompt-social_media_manager a cp:Prompt ;
    cp:componentId "social_media_manager" ;
    cp:appliesTo :SocialPost .

c:skill-postiz-campaign-post-from-asset a cp:Skill ;
    cp:componentId "postiz-campaign-post-from-asset" ;
    cp:appliesTo :SocialPost .

c:skill-postiz-content-scheduling a cp:Skill ;
    cp:componentId "postiz-content-scheduling" ;
    cp:appliesTo :SocialPost .

c:skill-postiz-channel-management a cp:Skill ;
    cp:componentId "postiz-channel-management" ;
    cp:appliesTo :SocialChannel .

c:skill-postiz-audience-analytics a cp:Skill ;
    cp:componentId "postiz-audience-analytics" ;
    cp:appliesTo :EngagementMetric .

c:skill-postiz-agent-operations a cp:Skill ;
    cp:componentId "postiz-agent-operations" ;
    cp:appliesTo :SocialPost .

c:contract a cp:IngestContract ;
    cp:contractOf c:connector ;
    cp:contractVersion "2" ;
    cp:privacyClass "internal" ;
    cp:hasSourceObject c:object-post, c:object-channel, c:object-engagement ;
    cp:hasCursorPolicy c:cursor ;
    cp:hasAccessPolicy c:access ;
    cp:requiresProvenance c:provenance .

c:object-post a cp:SourceObject ;
    cp:objectName "posts" ;
    cp:ontologyClass :SocialPost ;
    cp:hasKeyRule c:key-post .

c:key-post a cp:KeyRule ;
    cp:keyField "id" .

c:object-channel a cp:SourceObject ;
    cp:objectName "integrations" ;
    cp:ontologyClass :SocialChannel ;
    cp:hasKeyRule c:key-channel .

c:key-channel a cp:KeyRule ;
    cp:keyField "id" .

c:object-engagement a cp:SourceObject ;
    cp:objectName "analytics" ;
    cp:ontologyClass :DailyEngagement ;
    cp:hasKeyRule c:key-engagement .

c:key-engagement a cp:KeyRule ;
    cp:keyField "integration_id", "label", "date" .

c:cursor a cp:CursorPolicy ;
    cp:cursorKind "timestamp" .

c:access a cp:AccessPolicy ;
    cp:defaultAcl "quarantine" .

c:provenance a cp:ProvenanceRequirement ;
    cp:requiredField "source", "record_id", "as_of" .
