c:tool-postiz_generate_video a cp:Tool ;
    cp:componentId "postiz_generate_video" ;
    cp:operatesOn :SocialMediaAsset ;
    cp:produces :SocialMediaAsset .

c:tool-postiz_video_function a cp:Tool ;
    cp:componentId "postiz_video_function" ;
    cp:operatesOn :SocialMediaAsset ;
    cp:produces :SocialMediaAsset .

c:tool-postiz_start_clipping a cp:Tool ;
    cp:componentId "postiz_start_clipping" ;
    cp:operatesOn :SocialMediaAsset ;
    cp:produces :SocialMediaAsset .

c:tool-postiz_list_clippings a cp:Tool ;
    cp:componentId "postiz_list_clippings" ;
    cp:operatesOn :SocialMediaAsset ;
    cp:produces :SocialMediaAsset .

c:tool-postiz_get_clipping a cp:Tool ;
    cp:componentId "postiz_get_clipping" ;
    cp:operatesOn :SocialMediaAsset ;
    cp:produces :SocialMediaAsset .

c:feature-review a cp:Feature ;
    rdfs:label "Preview and review comments" ;
    cp:realizedBy c:tool-postiz_get_post_preview, c:tool-postiz_list_post_comments, c:tool-postiz_create_post_comment, c:skill-postiz-campaign-post-from-asset, c:prompt-social_media_manager .

c:tool-postiz_get_post_preview a cp:Tool ;
    cp:componentId "postiz_get_post_preview" ;
    cp:operatesOn :SocialPost ;
    cp:produces :SocialPost .

c:tool-postiz_list_post_comments a cp:Tool ;
    cp:componentId "postiz_list_post_comments" ;
    cp:operatesOn :PostReviewComment ;
    cp:produces :PostReviewComment .

c:tool-postiz_create_post_comment a cp:Tool ;
    cp:componentId "postiz_create_post_comment" ;
    cp:operatesOn :PostReviewComment ;
    cp:produces :PostReviewComment .

c:feature-analytics a cp:Feature ;
    rdfs:label "Audience analytics and notifications" ;
    cp:realizedBy c:tool-postiz_get_analytics, c:tool-postiz_get_post_analytics, c:tool-postiz_list_notifications, c:skill-postiz-audience-analytics, c:prompt-social_media_manager .

c:tool-postiz_get_analytics a cp:Tool ;
    cp:componentId "postiz_get_analytics" ;
    cp:operatesOn :AggregatedEngagement ;
    cp:produces :AggregatedEngagement .

c:tool-postiz_get_post_analytics a cp:Tool ;
    cp:componentId "postiz_get_post_analytics" ;
    cp:operatesOn :EngagementMetric ;
    cp:produces :EngagementMetric .

c:tool-postiz_list_notifications a cp:Tool ;
    cp:componentId "postiz_list_notifications" ;
